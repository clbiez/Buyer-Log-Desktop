# Buyer Log Desktop — source/distribution repository hygiene

# Installed dependencies are rebuilt deterministically with npm ci.
**/node_modules/

# Machine/user configuration. The desktop bootstrap creates config.json from
# resources/app/config.example.json on first run.
/config.json
**/.env
**/.env.*
!**/.env.example

# All mutable application state must stay outside Git.
/data/
/resources/app/server/data/
**/runtime-data/
**/local-data/
**/source-data/
**/BUYER_LOG_SYNC/
**/outbox/
**/inbox/

# User assets, exports and backups.
**/images/
**/model-images/
**/original-images/
**/thumbnails/
**/thumbnail-cache/
**/image-cache/
# Vendored CesiumJS ships its own credit logos under Assets/Images; on
# case-insensitive (Windows) checkouts the user-asset rule above would drop them.
!/resources/app/public/vendor/cesium/Assets/Images/
**/exports/
**/backups/
*.blgbackup
*.db
*.sqlite
*.sqlite3
*.bak

# Logs, caches, temporary files and generated reports.
**/logs/
**/cache/
**/temp/
**/tmp/
/.tmp/
*.log
*.tmp
npm-debug.log*
/resources/app/dist-updates/
/resources/app/dist-installer/
/resources/app/.release-pending.json
/coverage/
/.desktop-dev/
/.codebase-memory/
/server/data/.codebase-memory/
/.codex/
/.agents/

# Local-only maintenance helpers; they are not part of Buyer Log runtime.
/.GITHUB_SYNC_BUYER_LOG_DESKTOP.bat
/GITHUB_SYNC_BUYER_LOG_DESKTOP.bat
/.UPDATE_CODEBASE_MEMORY_*.cmd
/install.ps1
/Buyer Log Desktop Test/

# Updater-managed app-core versions and the generated portable manifest are
# per-installation runtime state. Committing them shipped stale 7.0.84/7.0.115
# artifacts to anyone who downloaded the source ZIP (7.0.178 field incident).
/.buyerlog-versions/
/manifest.json

# Build/release outputs are distributed through GitHub Releases, not source Git.
/BuyerLog.exe
/BuyerLog.exe/
/BuyerLog-Desktop-*.zip

# OS/editor debris.
.DS_Store
Thumbs.db
*.swp
*.swo
