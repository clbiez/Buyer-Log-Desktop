Info(plmId);\n  if(exact||!allowNameMatch)return exact;\n  return plmStyleLinksByModel.get(normalizePlmModelName(modelName))||null;\n}\nfunction plmModelLinkUrl(modelName,plmId=\'\',opts={}){\n  const item=plmModelLinkInfo(modelName,plmId,opts),styleId=normalizePlmLinkId(item&&item.styleId);\n  return styleId?`${PLM_STYLE_URL}?styleId=${styleId}&m=2`:\'\';\n}\nfunction plmModelLinkHtml(modelName,{plmId=\'\',iconOnly=false,allowNameMatch=true}={}){\n  const display=norm(modelName),url=plmModelLinkUrl(display,plmId,{allowNameMatch}),item=plmModelLinkInfo(display,plmId,{allowNameMatch});\n  if(!display)return \'\';\n  const openTitle=appLang===\'en\'?\'Open this model in CoreNectum PLM\':\'Bu modeli CoreNectum PLM’de aç\';\n  if(!url)return iconOnly?\'\':escapeHtml(display);\n  const detail=[item&&item.plmId,item&&item.specialCode].filter(Boolean).join(\' · \'),title=detail?`${openTitle} · ${detail}`:openTitle;\n  return `<a class="plmBridgeLink${iconOnly?\' plmBridgeIcon\':\'\'}" title="${escapeHtml(title)}" target="_blank" rel="noopener noreferrer" href="${escapeHtml(url)}" aria-label="${escapeHtml(openTitle)}">${iconOnly?\'↗\':escapeHtml(display)}</a>`;\n}\nwindow.BLPlmModelLinks={info:plmModelLinkInfo,url:plmModelLinkUrl,html:plmModelLinkHtml};\nfunction detailBridgeColumnRole(column){\n  const key=turknorm(String(column||\'\')).replace(/[^A-Z0-9]+/g,\'\');\n  if([\'SIPARISKOD\',\'SIPARISKODU\',\'ORDER\',\'ORDERCODE\',\'ORDERNO\',\'ORDERNUMBER\'].includes(key))return \'order\';\n  if([\'MODEL\',\'MODELAD\',\'MODELADI\',\'MODELNAME\',\'STYLENAME\'].includes(key))return \'model\';\n  if([\'PLM\',\'PLMID\',\'PLMCODE\',\'PLMKOD\',\'PLMKODU\'].includes(key))return \'plm\';\n  return \'\';\n}\nfunction detailOrderLinkHtml(orderCode,displayValue=orderCode){\n  const code=String(orderCode==null?\'\':orderCode).replace(/\\D/g,\'\').replace(/^0+(?=\\d)/,\'\');\n  const display=String(displayValue==null?\'\':displayValue).trim();\n  if(!code)return escapeHtml(display);\n  con